 TestNamedRanges←{
     f←##.Main.GetNamedRange
     p←' '∘≠⊆⊢
     fn←GetTestFileFQP'NamedRanges.xlsx'
     wi←##.Main.GetWorkbookInfo fn
     wi.HeaderRows←0
     ws←wi ##.Main.GetSheetData¨wi.SheetNames
     v←ws f'MyRange1'
     Assert v≡3 3⍴⍕¨1+⍳9:
     v←ws f'PI'
     Assert v≡1 1⍴⊂'3.14':
     v←ws f'MyRange2'
     Assert v≡3 4⍴,¨'abcdefghijkl':
     v←ws f'MyRange3'
     Assert v≡2 3⍴⊂'Blah':
     v←ws f'MyRange3' 'Sheet2'
     Assert v≡2 3⍴⊂'Blah':
     v←(1⊃ws)f'MyRange3'
     Assert v≡2 3⍴⊂'Blah':
     v←ws f'LocalScopeRange'
     Assert v≡3 3⍴p'This is Local and can be on different sheets':
     v←ws f'LocalScopeRange' 'Sheet1'
     Assert v≡3 3⍴p'This is Local and can be on different sheets':
     v←ws f'LocalScopeRange' 'Sheet2'
     Assert v≡3 3⍴p'This is the same named range on another sheet':
     0
 }
